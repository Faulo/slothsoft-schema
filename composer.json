{
    "name": "slothsoft/schema",
    "description": "A Farah module for processing XML Schema files.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=8.2",
        "slothsoft/core": "^1.15.1",
        "slothsoft/farah": "^1.29.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.4",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.14"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Schema\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Schema\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.8.x-dev"
        }
    },
    "homepage": "http://farah.slothsoft.net/modules/schema",
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
